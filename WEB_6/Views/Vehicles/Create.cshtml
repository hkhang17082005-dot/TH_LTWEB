@model WEB_6.Models.Vehicle

@{
    ViewData["Title"] = "Thêm Vi Phạm";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger alert alert-danger" role="alert"></div>

                <div class="form-group mb-3">
                    <label asp-for="BienSoXe" class="form-label"></label>
                    <input asp-for="BienSoXe" class="form-control" placeholder="VD: 54P6-13844" required />
                    <span asp-validation-for="BienSoXe" class="text-danger"></span>
                    <small class="form-text text-muted">Định dạng: 2 chữ số + 1 chữ cái + 1 chữ số - 5 chữ số</small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="VehicleTypeId" class="form-label"></label>
                    <select asp-for="VehicleTypeId" asp-items="@(ViewData["VehicleTypeId"] as SelectList)" class="form-select" required>
                        <option value="">-- Chọn loại phương tiện --</option>
                    </select>
                    <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ThoiGianViPham" class="form-label"></label>
                    <input asp-for="ThoiGianViPham" class="form-control" type="datetime-local" required />
                    <span asp-validation-for="ThoiGianViPham" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NoiDung" class="form-label"></label>
                    <textarea asp-for="NoiDung" class="form-control" rows="3" placeholder="Mô tả chi tiết vi phạm" required></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success">Lưu</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
