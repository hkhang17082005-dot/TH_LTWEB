@model IEnumerable<WEB_6.Models.Vehicle>

@{
    ViewData["Title"] = "Duyệt Phản Ánh";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Biển số xe</th>
                        <th>Loại phương tiện</th>
                        <th>Thời gian vi phạm</th>
                        <th>Nội dung</th>
                        <th>Hình ảnh</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@Html.DisplayFor(modelItem => item.BienSoXe)</strong></td>
                            <td>@Html.DisplayFor(modelItem => item.VehicleType.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.ThoiGianViPham, "{0:dd/MM/yyyy HH:mm}")</td>
                            <td>
                                <span title="@item.NoiDung">
                                    @(item.NoiDung?.Length > 50 ? item.NoiDung.Substring(0, 50) + "..." : item.NoiDung)
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.HinhAnh))
                                {
                                    <a href="~/images/@item.HinhAnh" target="_blank" class="btn btn-sm btn-info">Xem ảnh</a>
                                }
                                else
                                {
                                    <span class="text-muted">Không có</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-warning">Chưa xử lý</span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-success">Xử lý</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi tiết</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success" role="alert">
            Hiện tại không có phản ánh nào đang chờ xử lý!
        </div>
    }

    <a asp-action="Index" asp-controller="Vehicles" class="btn btn-secondary mt-3">Quay lại danh sách vi phạm</a>
</div>