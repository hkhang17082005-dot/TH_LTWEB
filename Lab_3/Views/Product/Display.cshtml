@model Lab_3.Models.Product

<div class="container mt-5">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
      </ol>
    </nav>

    <div class="card shadow border-0 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageURL) ? "/images/no-image.png" : Model.ImageURL)" 
                     class="img-fluid rounded shadow-sm" style="max-height: 400px;" alt="@Model.Name">
            </div>
            <div class="col-md-7 p-5">
                <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
                <h1 class="display-5 fw-bold mb-3 text-dark">@Model.Name</h1>
                <h2 class="text-success fw-bold mb-4">@Model.Price.ToString("C")</h2>
                
                <h5 class="fw-semibold text-muted">Mô tả:</h5>
                <p class="fs-5 text-secondary">@Model.Description</p>

                <div class="mt-5 border-top pt-4">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning btn-lg px-4 me-2 shadow-sm">
                        Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 shadow-sm"> Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>