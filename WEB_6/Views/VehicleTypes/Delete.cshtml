@model WEB_6.Models.VehicleType

@{
    ViewData["Title"] = "Xóa Loại Phương Tiện";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Xác nhận xóa</h4>
                <p>Bạn có chắc chắn muốn xóa loại phương tiện: <strong>@Model.Name</strong>?</p>
                <hr />
                <p class="mb-0">Hành động này không thể hoàn tác.</p>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id">
                <div class="form-group">
                    <button type="submit" class="btn btn-danger">Xóa</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
