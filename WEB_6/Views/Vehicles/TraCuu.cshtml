@model WEB_6.Models.Vehicle

@{
    ViewData["Title"] = "Tra cứu Vi phạm";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">Nhập biển số xe để kiểm tra các vi phạm đã ghi nhận</p>
    <hr />

    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="TraCuu" method="get" class="input-group">
                <input type="text" 
                       name="SearchString" 
                       class="form-control form-control-lg" 
                       placeholder="VD: 54P6-13844" 
                       aria-label="Biển số xe" 
                       required />
                <button class="btn btn-primary btn-lg" type="submit">Tra cứu</button>
            </form>
            <small class="form-text text-muted d-block mt-2">
                Định dạng: 2 chữ số + 1 chữ cái + 1 chữ số - 5 chữ số
            </small>
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Thông báo:</strong> @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null)
    {
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Thông tin Vi phạm</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">Biển số xe</h6>
                        <p class="fs-5"><strong>@Model.BienSoXe</strong></p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Loại phương tiện</h6>
                        <p class="fs-5"><strong>@Model.VehicleType?.Name</strong></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted">Thời gian vi phạm</h6>
                        <p class="fs-5"><strong>@Model.ThoiGianViPham.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Trạng thái</h6>
                        <p class="fs-5">
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success">Đã xử lý</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Chưa xử lý</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <h6 class="text-muted">Nội dung vi phạm</h6>
                        <p>@Model.NoiDung</p>
                    </div>
                </div>

                @if (Model.VehicleImages != null && Model.VehicleImages.Any())
                {
                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-muted mb-3">Hình ảnh vi phạm (@Model.VehicleImages.Count)</h6>
                            <div class="row">
                                @foreach (var image in Model.VehicleImages)
                                {
                                    <div class="col-md-4 mb-3">
                                        <a href="~/images/@image.ImagePath" target="_blank" data-bs-toggle="modal" data-bs-target="#imageModal" onclick="setModalImage('~/images/@image.ImagePath')">
                                            <img src="~/images/@image.ImagePath" alt="Hình ảnh vi phạm" class="img-fluid rounded" style="max-width: 100%; height: 200px; object-fit: cover;" />
                                        </a>
                                        <small class="text-muted d-block mt-2">@image.UploadedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary mt-4">Quay lại</a>
</div>

<!-- Modal để xem ảnh lớn -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Xem hình ảnh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="Hình ảnh" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setModalImage(imagePath) {
            document.getElementById('modalImage').src = imagePath;
        }
    </script>
}
