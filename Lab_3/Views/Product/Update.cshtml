@model Lab_3.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container">
    <h2>Edit Product</h2>
    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label">Current Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageURL))
            {
                <div class="mb-2">
                    <img src="@Model.ImageURL" alt="Product Image" style="max-width: 200px; border: 1px solid #ddd;" />
                </div>
            }
            <label for="imageUrl" class="form-label">Change Image</label>
            <input type="file" name="imageUrl" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-warning">Update Product</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>