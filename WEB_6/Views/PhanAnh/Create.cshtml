@model WEB_6.Models.Vehicle

@{
    ViewData["Title"] = "Phản ánh Vi phạm";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>@ViewData["Title"]</h1>
            <hr />

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="BienSoXe" class="form-label"></label>
                    <input asp-for="BienSoXe" class="form-control" placeholder="VD: 54P6-13844" onchange="showBienSo()" />
                    <span asp-validation-for="BienSoXe" class="text-danger"></span>
                    <small class="form-text text-muted">Định dạng: 2 chữ số + 1 chữ cái + 1 chữ số - 5 chữ số</small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="VehicleTypeId" class="form-label"></label>
                    <select asp-for="VehicleTypeId" asp-items="@(ViewData["VehicleTypeId"] as SelectList)" class="form-select">
                        <option value="">-- Chọn loại phương tiện --</option>
                    </select>
                    <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ThoiGianViPham" class="form-label"></label>
                    <input asp-for="ThoiGianViPham" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ThoiGianViPham" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NoiDung" class="form-label"></label>
                    <textarea asp-for="NoiDung" class="form-control" rows="5" placeholder="Mô tả chi tiết vi phạm"></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="HinhAnhUpload" class="form-label">Hình ảnh vi phạm (có thể chọn nhiều)</label>
                    <input type="file" id="HinhAnhUpload" name="HinhAnhUpload" class="form-control" accept="image/*" multiple onchange="previewImages()" />
                    <small class="form-text text-muted">Chọn file hình ảnh (JPG, PNG, etc.). Có thể chọn nhiều file.</small>
                </div>

                <!-- Preview hình ảnh -->
                <div id="imagePreview" class="mb-3">
                    <div id="previewContainer" class="row"></div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success">Gửi phản ánh</button>
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImages() {
            const files = document.getElementById('HinhAnhUpload').files;
            const previewContainer = document.getElementById('previewContainer');
            previewContainer.innerHTML = '';

            if (files.length === 0) {
                document.getElementById('imagePreview').style.display = 'none';
                return;
            }

            document.getElementById('imagePreview').style.display = 'block';

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();

                reader.onload = function (e) {
                    const col = document.createElement('div');
                    col.className = 'col-md-4 mb-3';
                    col.innerHTML = `
                        <div class="card">
                            <img src="${e.target.result}" class="card-img-top" alt="Preview" style="height: 200px; object-fit: cover;">
                            <div class="card-body p-2">
                                <small class="text-muted">${file.name}</small>
                            </div>
                        </div>
                    `;
                    previewContainer.appendChild(col);
                };

                reader.readAsDataURL(file);
            }
        }

        function showBienSo() {
            const bienSo = document.querySelector('input[name="BienSoXe"]').value;
            if (bienSo) {
                console.log('Biển số: ' + bienSo);
            }
        }
    </script>
}

